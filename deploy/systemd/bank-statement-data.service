# Example unit for the stand (FIN-149): Go services under systemd, one PostgreSQL.
# Install as /etc/systemd/system/bank-statement-data.service.
# The deploy script runs "<binary> migrate up" (same environment) before restarting the unit.
#
# Secrets are systemd credentials, not environment variables: they do not show up in
# "systemctl show" or /proc/<pid>/environ.
#   /etc/finassist/bank-statement-data/env            non-secret settings (see docs/config.md); EnvironmentFile=
#                                                     overrides Environment=, so it must not set what this unit sets
#   /etc/finassist/bank-statement-data/db-primary-dsn DSN, mode 0600, owner root
#   /etc/finassist/bank-statement-data/stage-signing-key.pem  stand signing key, mode 0600, owner root (LoadCredential)
#   /etc/finassist/stage-public.jwks                  stand public JWKS shared by all services, mode 0644
#                                                     (/etc/finassist 0755): DynamicUser reads it directly
[Unit]
Description=fin-assist bank-statement-data
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/finassist/bank-statement-data/bank-statement-data serve
EnvironmentFile=/etc/finassist/bank-statement-data/env
Environment=ENV=stage
# SERVICE_NAME is the kid/sub of the stand signing key and must match its kid in the shared JWKS.
Environment=SERVICE_NAME=bank-statement-data
LoadCredential=db-primary-dsn:/etc/finassist/bank-statement-data/db-primary-dsn
Environment=DB_PRIMARY_DSN_FILE=%d/db-primary-dsn
# With ENV=stage and AUTH_MODE=verify (the default) service identity uses the stand key files
# (FIN-267, docs/config.md): env must set AUTH_STAGE_ISSUER, as well as AUTH_USER_ISSUER,
# AUTH_USER_AUDIENCE and PEER_USER_ADDR. Without these files and settings the unit does not start.
LoadCredential=stage-signing-key:/etc/finassist/bank-statement-data/stage-signing-key.pem
Environment=AUTH_STAGE_SIGNING_KEY_FILE=%d/stage-signing-key
Environment=AUTH_STAGE_PUBLIC_KEYS_FILE=/etc/finassist/stage-public.jwks
# ENV=prod (Kubernetes, AUTH_KUBERNETES_* and SERVICE_TOKEN_FILE) is not deployed by this unit.

DynamicUser=yes
Restart=on-failure
RestartSec=2s
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT (5s + 20s by default) plus a margin.
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
