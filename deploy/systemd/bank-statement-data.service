# Example unit for the stand (FIN-149): Go services under systemd, one PostgreSQL.
# Install as /etc/systemd/system/bank-statement-data.service.
# The deploy script runs "<binary> migrate up" (same environment) before restarting the unit.
#
# Secrets are systemd credentials, not environment variables: they do not show up in
# "systemctl show" or /proc/<pid>/environ.
#   /etc/finassist/bank-statement-data/env            non-secret settings (see docs/config.md)
#   /etc/finassist/bank-statement-data/db-primary-dsn DSN, mode 0600, owner root
#   /etc/finassist/bank-statement-data/stage-signing-key.pem stand signing key, mode 0600, owner root
#   /etc/finassist/stand/stage-public-keys.json      stand public JWKS shared by all services, mode 0644
[Unit]
Description=fin-assist bank-statement-data
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/finassist/bank-statement-data/bank-statement-data serve
EnvironmentFile=/etc/finassist/bank-statement-data/env
Environment=ENV=stage
LoadCredential=db-primary-dsn:/etc/finassist/bank-statement-data/db-primary-dsn
Environment=DB_PRIMARY_DSN_FILE=%d/db-primary-dsn
# AUTH_MODE=verify on the stand (FIN-267, docs/config.md): AUTH_USER_ISSUER, AUTH_USER_AUDIENCE,
# AUTH_STAGE_ISSUER and PEER_USER_ADDR go to the env file; the stand keys go the same way as the DSN:
LoadCredential=stage-signing-key:/etc/finassist/bank-statement-data/stage-signing-key.pem
Environment=AUTH_STAGE_SIGNING_KEY_FILE=%d/stage-signing-key
LoadCredential=stage-public-keys:/etc/finassist/stand/stage-public-keys.json
Environment=AUTH_STAGE_PUBLIC_KEYS_FILE=%d/stage-public-keys

DynamicUser=yes
Restart=on-failure
RestartSec=2s
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT (5s + 20s by default) plus a margin.
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
